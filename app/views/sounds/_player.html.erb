<%# When peaks + duration are present the player draws the waveform from them and
    only fetches the audio on Play; otherwise it falls back to downloading the
    file up front to compute the waveform (the pre-cache behavior). %>
<div class="rounded-md border border-gray-200 bg-gray-50 px-4 py-3"
     data-controller="waveform"
     data-waveform-url-value="<%= rails_blob_path(sound.audio) %>"
     data-waveform-play-url-value="<%= play_sound_path(sound) %>"
     <% if sound.waveform_peaks.present? && sound.duration.to_f > 0 %>
       data-waveform-peaks-value="<%= sound.waveform_peaks.to_json %>"
       data-waveform-duration-value="<%= sound.duration %>"
     <% end %>>
  <div class="flex items-center gap-3">
    <button type="button"
            aria-label="Play"
            data-waveform-target="playPause"
            data-action="waveform#togglePlay"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer">
      <%# The icons are drawn from primitives rather than path data so the shapes
          stay legible: play is a right-pointing triangle, pause is two bars. %>
      <svg data-waveform-target="playIcon" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <polygon points="4,2 18,10 4,18" />
      </svg>
      <svg data-waveform-target="pauseIcon" class="hidden h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <rect x="3" y="2" width="5" height="16" rx="1" />
        <rect x="12" y="2" width="5" height="16" rx="1" />
      </svg>
    </button>
    <div data-waveform-target="waveform" class="min-w-0 flex-1"></div>
  </div>

  <div class="mt-2 flex items-center justify-between text-xs text-gray-500">
    <span data-waveform-target="time">0:00 / 0:00</span>
    <label class="flex items-center gap-1">
      Speed
      <%= select_tag "speed",
            options_for_select(
              [["0.5×", "0.5"], ["0.75×", "0.75"], ["1×", "1"],
               ["1.25×", "1.25"], ["1.5×", "1.5"], ["2×", "2"]],
              "1"),
            data: { waveform_target: "speed", action: "waveform#changeSpeed" },
            class: "rounded border border-gray-300 bg-white px-1 py-0.5 text-xs" %>
    </label>
  </div>
</div>
